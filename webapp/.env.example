# Copy to ../.env (webapp/.env) for local backend, or set these in Render.

# Garmin Connect credentials (needed for first login / token refresh).
EMAIL=your-garmin-email@example.com
PASSWORD=your-garmin-password

# Optional: override cache + token locations (Render sets these for you).
# WORKOUT_DATA_DIR=../data
# GARMINTOKENS=~/.garminconnect

# Comma-separated frontend origins allowed to call the API (no trailing slash).
# After deploying Vercel, set this to your production URL, e.g.:
# CORS_ORIGINS=https://runningweb.vercel.app
CORS_ORIGINS=
